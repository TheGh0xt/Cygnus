# Cygnus — Layers 3, 4, 5
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# Required by Google ADK for Gemini model access.
GOOGLE_API_KEY=

# HTTP URL of the Sagittarius MCP server (Layers 1+2).
# Local default; in docker-compose this becomes http://sagittarius:8080/mcp
SAGITTARIUS_MCP_URL=http://localhost:8080/mcp

# Path to the Layer 3 SQLite memory store used by the evaluation worker.
PMIE_DB_PATH=pmie_memory.db
