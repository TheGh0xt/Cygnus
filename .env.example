# Cygnus — Layers 3, 4, 5
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# Required by Google ADK for Gemini model access.
GOOGLE_API_KEY=

# HTTP URL of the Sagittarius MCP server (Layers 1+2).
# Local default; in docker-compose this becomes http://sagittarius:8080/mcp
SAGITTARIUS_MCP_URL=http://localhost:8080/mcp

# Path to the Layer 3 SQLite memory store used by the evaluation worker.
PMIE_DB_PATH=pmie_memory.db

# Supabase (Auth + Postgres). Auth tokens are verified locally against
# the JWKS endpoint; the service role key is server-side only and must never
# reach the browser.
# Either name works for the secret. Supabase's own "Connect to your project"
# panel hands you SUPABASE_SECRET_KEY, so that block can be pasted as-is.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=sb_secret_...
#
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_JWKS_URL from that panel are NOT used
# here: the publishable key belongs in the web client, and the JWKS URL is
# derived from SUPABASE_URL.

# Local development only: skips authentication and the invite gate.
# Read once at startup so it cannot be flipped in a running process.
# PMIE_AUTH_DISABLED=1

# Rate limits on starting an analysis. Protects the model budget.
# 0 disables a limit.
PMIE_RATE_LIMIT_PER_USER=10
PMIE_RATE_LIMIT_GLOBAL=60
PMIE_RATE_LIMIT_WINDOW_SECONDS=3600
