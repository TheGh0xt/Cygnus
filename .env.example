# Cygnus — Layers 3, 4, 5
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# Required by Google ADK for Gemini model access.
GOOGLE_API_KEY=

# HTTP URL of the Sagittarius MCP server (Layers 1+2).
# Local default; in docker-compose this becomes http://sagittarius:8080/mcp
SAGITTARIUS_MCP_URL=http://localhost:8080/mcp

# Bearer token sent as `Authorization: Bearer <token>` on every MCP
# connection to Sagittarius (agent toolsets and the evaluation worker's own
# client). Must be the same name and value Sagittarius reads to enforce
# bearer auth on /mcp. Unset locally — Sagittarius doesn't enforce without
# it, so leaving this blank is the normal local-development case.
# MCP_BEARER_TOKEN=

# Path to the Layer 3 SQLite memory store used by the evaluation worker.
PMIE_DB_PATH=pmie_memory.db

# The explicit deploy-environment signal. Unset (or anything but
# "production") is treated as development/CI: Postgres is used when
# configured, SQLite otherwise, same as always.
#
# Set to "production" on every deployed instance (both Render services).
# When set, a missing or unreachable Postgres store fails startup instead of
# silently falling back to SQLite — a deployed container's disk is wiped on
# every restart, and the price recorded at report time cannot be
# reconstructed afterwards. Never inferred from a platform var like RENDER:
# this is a deliberate choice, not a hosting detail.
# PMIE_ENVIRONMENT=production

# Supabase (Auth + Postgres). Auth tokens are verified locally against
# the JWKS endpoint; the service role key is server-side only and must never
# reach the browser.
# Either name works for the secret. Supabase's own "Connect to your project"
# panel hands you SUPABASE_SECRET_KEY, so that block can be pasted as-is.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=sb_secret_...
#
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_JWKS_URL from that panel are NOT used
# here: the publishable key belongs in the web client, and the JWKS URL is
# derived from SUPABASE_URL.

# Local development only: skips authentication and the invite gate.
# Read once at startup so it cannot be flipped in a running process.
# PMIE_AUTH_DISABLED=1

# Rate limits on starting an analysis. Protects the model budget.
# 0 disables a limit.
PMIE_RATE_LIMIT_PER_USER=10
PMIE_RATE_LIMIT_GLOBAL=60
PMIE_RATE_LIMIT_WINDOW_SECONDS=3600

# How long to wait for Sagittarius. The ADK default is 5s, which is far
# too short for a container that sleeps when idle: every Sagittarius-backed
# stage fails and the analyst silently produces a news-only report.
SAGITTARIUS_TIMEOUT_SECONDS=90

# Shared secret the scheduled evaluation workflow presents. The trigger
# endpoint is closed unless this is set.
PMIE_CRON_SECRET=
