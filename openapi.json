{
  "components": {
    "schemas": {
      "AnalysisCreated": {
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "stream_url": {
            "title": "Stream Url",
            "type": "string"
          }
        },
        "required": [
          "analysis_id",
          "stream_url",
          "status"
        ],
        "title": "AnalysisCreated",
        "type": "object"
      },
      "AnalysisRequest": {
        "properties": {
          "query": {
            "maxLength": 800,
            "minLength": 3,
            "title": "Query",
            "type": "string"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          }
        },
        "required": [
          "query"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResult": {
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketAnalysisReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "analysis_id",
          "status"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "CausalDriver": {
        "enum": [
          "WHALE_ACTIVITY",
          "VOLUME_SPIKE",
          "LIQUIDITY_CRUNCH",
          "EXTERNAL_NEWS",
          "UNKNOWN_ANOMALY"
        ],
        "title": "CausalDriver",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoricalContextMatch": {
        "properties": {
          "previous_market_id": {
            "title": "Previous Market Id",
            "type": "string"
          },
          "prior_explanation_accuracy": {
            "title": "Prior Explanation Accuracy",
            "type": "number"
          }
        },
        "required": [
          "previous_market_id",
          "prior_explanation_accuracy"
        ],
        "title": "HistoricalContextMatch",
        "type": "object"
      },
      "Impact": {
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ],
        "title": "Impact",
        "type": "string"
      },
      "KeyDriver": {
        "properties": {
          "evidence_summary": {
            "title": "Evidence Summary",
            "type": "string"
          },
          "impact": {
            "$ref": "#/components/schemas/Impact"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "impact",
          "evidence_summary"
        ],
        "title": "KeyDriver",
        "type": "object"
      },
      "MarketAnalysisReport": {
        "properties": {
          "confidence_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score",
            "type": "number"
          },
          "historical_context_match": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HistoricalContextMatch"
              },
              {
                "type": "null"
              }
            ]
          },
          "key_drivers": {
            "items": {
              "$ref": "#/components/schemas/KeyDriver"
            },
            "title": "Key Drivers",
            "type": "array"
          },
          "market_id": {
            "title": "Market Id",
            "type": "string"
          },
          "primary_causal_driver": {
            "$ref": "#/components/schemas/CausalDriver"
          },
          "summary": {
            "maxLength": 500,
            "title": "Summary",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "market_id",
          "timestamp",
          "summary",
          "primary_causal_driver",
          "confidence_score",
          "key_drivers"
        ],
        "title": "MarketAnalysisReport",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Causal explanations for Polymarket price moves.",
    "title": "PMIE API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/analyses": {
      "post": {
        "operationId": "create_analysis_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Analysis"
      }
    },
    "/v1/analyses/{analysis_id}": {
      "get": {
        "operationId": "get_analysis_v1_analyses__analysis_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Analysis"
      }
    },
    "/v1/analyses/{analysis_id}/events": {
      "get": {
        "operationId": "stream_analysis_v1_analyses__analysis_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent events. One `stage_started` / `stage_completed` pair per pipeline stage (event_retrieval, signal_retrieval, news_retrieval, analysis), then a terminal `report` or `error` event. Each `data:` line is a JSON object `{stage, data}`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Analysis"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready V1 Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    }
  }
}
